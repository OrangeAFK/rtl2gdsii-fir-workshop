#!/usr/bin/env bash
# Workshop helper: open an .odb (or pass-through args) in OpenROAD GUI.
set -euo pipefail
if [[ $# -lt 1 ]]; then
  echo "Usage: openroad_gui <design.odb>" >&2
  exit 1
fi
FILE="$1"
shift || true
if [[ ! -f "$FILE" ]]; then
  echo "File not found: $FILE" >&2
  exit 1
fi
exec openroad -gui "$FILE" "$@"
